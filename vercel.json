{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/admin/:path*",
      "destination": "/api/index?path=/:path*"
    },
    {
      "source": "/",
      "destination": "/BAUST/BAUST/index.html"
    },
    {
      "source": "/site",
      "destination": "/BAUST/BAUST/index.html"
    },
    {
      "source": "/site/:path*",
      "destination": "/BAUST/BAUST/:path*"
    }
  ]
}