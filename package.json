{
  "name": "alumni-management-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "audit": "npm --prefix backend audit --audit-level=moderate",
    "auto": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/update-project.ps1",
    "auto:full": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/update-project.ps1 -UpdateDependencies -Audit -UpscaleImages",
    "hd:images": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/upscale-images.ps1 -Scale 2",
    "install": "npm --prefix backend install",
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "static": "node scripts/static-server.js",
    "update": "npm --prefix backend update"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^7.6.0",
    "morgan": "^1.10.0"
  }
}
